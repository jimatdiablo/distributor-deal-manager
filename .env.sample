DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=distdb
DB_USER=ddm
DB_PASSWORD=change-me
DDM_MYSQL_ROOT_PASSWORD=change-me-root
DDM_APP_PORT=8080
DDM_RUN_MIGRATIONS=true
DDM_ADMIN_EMAIL=
DDM_ADMIN_PASSWORD=
DDM_ADMIN_NAME=Initial Admin

# Maat replaces password login when enabled. Access still requires an active
# DDM user with a valid role and (for agent viewers) distributor assignment.
MAAT_ENABLED=0
MAAT_INTERNAL_URL=http://host.docker.internal:4000
MAAT_JWKS_URL=
MAAT_SERVICE_TOKEN=
MAAT_COOKIE_DOMAINS=.lvh.me
MAAT_SECURE_COOKIES=0
MAAT_HTTP_TIMEOUT_MS=10000
